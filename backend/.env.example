# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9025

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/invoice_management

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Both secrets MUST be at least 32 characters. The server refuses to boot otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Password hashing ─────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Superadmin ──────────────────────────────────────────────────────────────
# Seed credentials (used only on first boot, when no superadmin exists)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Change@me!123
# The database ID of the root superadmin. This account cannot be deleted or demoted.
# The server logs the ID after seeding — copy it here.
SUPERADMIN_ID=1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend URL — used as the CORS origin when CORS_ORIGINS is not set.
FRONTEND_URL=http://localhost:5173

# Comma-separated origin allowlist. Overrides FRONTEND_URL when set.
# Leave empty to use FRONTEND_URL as the sole allowed origin.
CORS_ORIGINS=

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Set to true ONLY when the SPA and API are on different domains. Requires HTTPS.
COOKIE_CROSS_SITE=false

# ─── Uploads ──────────────────────────────────────────────────────────────────
MAX_LOGO_SIZE_MB=5
