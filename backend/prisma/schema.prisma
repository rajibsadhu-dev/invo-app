generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  superadmin
  user
}

enum OrgRole {
  owner
  admin
  manager
  staff
  viewer
}

enum InvoiceStatus {
  draft
  sent
  paid
  cancelled
}

enum PaymentMethod {
  cash
  bank
  upi
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  phone           String?
  role            UserRole  @default(user)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  organizations   Organization[]
  orgMemberships  OrgMember[]
  sentInvites     OrgInvite[]
  createdInvoices Invoice[]      @relation("InvoicesCreated")
  stockMovements  StockMovement[] @relation("StockMovementCreatedBy")

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Organization {
  id                Int      @id @default(autoincrement())
  name              String
  ownerId           Int      @map("owner_id")
  address           String?  @db.Text
  phone             String?
  email             String?
  logo              String?
  registerNumber    String?  @map("register_number")
  gstNumber         String?  @map("gst_number")
  /// Two-digit GST state code of the supplier (e.g. "27" = Maharashtra).
  /// Required before any GST-rated invoice can be raised.
  stateCode         String?  @map("state_code") @db.VarChar(2)
  /// What the business does, e.g. "Trading", "Manufacturing", "Services". Free text:
  /// the suggestion list on the frontend is a convenience, not a constraint, and it
  /// drives which optional fields the invoice form offers.
  businessType      String?  @map("business_type")
  invoicePrefix     String   @default("INV") @map("invoice_prefix")
  nextInvoiceNumber Int      @default(1) @map("next_invoice_number")
  /// When to deduct stock on invoice status change: "sent" (default) or "created".
  deductStockOn     String   @default("sent") @map("deduct_stock_on") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Restrict, not Cascade: deleting a user must never take an organization — and with it
  // every invoice ever raised — down with it. Reassign ownership first.
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members           OrgMember[]
  invites           OrgInvite[]
  customers         Customer[]
  invoices          Invoice[]
  categories        ProductCategory[]
  products          Product[]
  variantAttributes VariantAttribute[]
  stockMovements    StockMovement[]

  @@map("organizations")
}

model OrgMember {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  userId         Int      @map("user_id")
  role           OrgRole  @default(staff)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_members")
}

model OrgInvite {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  email          String
  role           OrgRole  @default(staff)
  token          String   @unique @db.VarChar(512)
  expiresAt      DateTime @map("expires_at")
  invitedById    Int      @map("invited_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([token])
  @@map("org_invites")
}

model Customer {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?  @db.Text
  gstNumber      String?  @map("gst_number")
  /// Two-digit GST state code of the recipient. Determines intra- vs inter-state supply.
  stateCode      String?  @map("state_code") @db.VarChar(2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId, name])
  @@map("customers")
}

model ProductCategory {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    String?  @db.Text
  /// Self-reference: categories nest to arbitrary depth.
  parentId       Int?     @map("parent_id")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a parent must not silently take its subtree with it.
  parent       ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     ProductCategory[] @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, name, parentId])
  @@index([organizationId])
  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  categoryId     Int?     @map("category_id")
  name           String
  sku            String?  @db.VarChar(50)
  description    String?  @db.Text
  /// HSN (goods) or SAC (services) code, copied onto invoice lines that use this product.
  hsnCode        String?  @map("hsn_code") @db.VarChar(8)
  /// Unit of measure: pcs, kg, m, hr...
  unit           String?  @db.VarChar(20)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(12, 2)
  purchasePrice  Decimal? @map("purchase_price") @db.Decimal(12, 2)
  /// Default GST percentage for this product; the invoice line may still override it.
  gstRate        Decimal  @default(18) @map("gst_rate") @db.Decimal(5, 2)
  /// Stock quantity for non-variant products. Variant products track stock per variant.
  stockQuantity  Decimal  @default(0) @map("stock_quantity") @db.Decimal(10, 3)
  lowStockAlert  Decimal? @map("low_stock_alert") @db.Decimal(10, 3)
  /// Deactivated rather than deleted once a product has been invoiced.
  isActive       Boolean  @default(true) @map("is_active")
  hasVariants    Boolean  @default(false) @map("has_variants")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, categoryId])
  @@index([organizationId, name])
  @@map("products")
}

model VariantAttribute {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  /// Attribute name: "Size", "Color", "Material", etc.
  name           String
  /// Allowed values as a JSON array: ["S", "M", "L", "XL"]
  values         Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("variant_attributes")
}

model ProductVariant {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  sku            String?  @db.VarChar(50)
  /// Display name, usually auto-generated: "Red / M".
  name           String
  /// The attribute values for this variant: { "Color": "Red", "Size": "M" }
  attributes     Json
  /// Variant-level price override; null = use the parent product's sellingPrice.
  sellingPrice   Decimal? @map("selling_price") @db.Decimal(12, 2)
  purchasePrice  Decimal? @map("purchase_price") @db.Decimal(12, 2)
  /// Stock quantity for this specific variant.
  stockQuantity  Decimal  @default(0) @map("stock_quantity") @db.Decimal(10, 3)
  lowStockAlert  Decimal? @map("low_stock_alert") @db.Decimal(10, 3)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model Invoice {
  id                  Int            @id @default(autoincrement())
  organizationId      Int            @map("organization_id")
  customerId          Int            @map("customer_id")
  createdById         Int?           @map("created_by_id")
  invoiceNumber       String         @map("invoice_number")
  invoiceDate         DateTime       @default(now()) @map("invoice_date")
  /// Sum of line amounts, before discount and before tax.
  subtotal            Decimal        @db.Decimal(12, 2)
  /// Total GST charged = cgstTotal + sgstTotal + igstTotal.
  /// Invoices raised before the GST migration retain their original flat tax amount here.
  tax                 Decimal        @default(0) @db.Decimal(12, 2)
  discount            Decimal        @default(0) @db.Decimal(12, 2)
  /// subtotal − discount: the value GST is actually charged on.
  taxableValue        Decimal        @default(0) @map("taxable_value") @db.Decimal(12, 2)
  cgstTotal           Decimal        @default(0) @map("cgst_total") @db.Decimal(12, 2)
  sgstTotal           Decimal        @default(0) @map("sgst_total") @db.Decimal(12, 2)
  igstTotal           Decimal        @default(0) @map("igst_total") @db.Decimal(12, 2)
  /// Difference between the computed total and the rupee it was rounded to.
  roundOff            Decimal        @default(0) @map("round_off") @db.Decimal(6, 2)
  /// Two-digit state code of the place of supply, frozen at issue time so a later
  /// change to the customer's address cannot rewrite history.
  placeOfSupply       String?        @map("place_of_supply") @db.VarChar(2)
  /// True when supplier and recipient are in the same state (CGST + SGST rather than IGST).
  isIntraState        Boolean        @default(true) @map("is_intra_state")
  grandTotal          Decimal        @map("grand_total") @db.Decimal(12, 2)
  receivedAmount      Decimal        @default(0) @map("received_amount") @db.Decimal(12, 2)
  status              InvoiceStatus  @default(draft)
  amountInWords       String?        @map("amount_in_words") @db.VarChar(500)
  // Optional reference fields
  challanNo           String?        @map("challan_no")
  vehicleNo           String?        @map("vehicle_no")
  siteLocation        String?        @map("site_location")
  billingAddress      String?        @map("billing_address") @db.Text
  referenceNumber     String?        @map("reference_number")
  // Payment info
  paymentMethod       PaymentMethod? @map("payment_method")
  bankName            String?        @map("bank_name")
  bankAccount         String?        @map("bank_account")
  bankIfsc            String?        @map("bank_ifsc")
  transactionNumber   String?        @map("transaction_number")
  // Footer fields
  termsAndConditions  String?        @map("terms_and_conditions") @db.Text
  notes               String?        @db.Text
  authorizedSignatory String?        @map("authorized_signatory")
  /// Soft delete. Invoices are financial records: they are withdrawn, never destroyed.
  deletedAt           DateTime?      @map("deleted_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("InvoicesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  items        InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, invoiceDate])
  @@index([organizationId, deletedAt])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id               Int     @id @default(autoincrement())
  invoiceId        Int     @map("invoice_id")
  /// Set when the line was picked from the catalogue; null for a hand-typed line.
  /// The descriptive fields are still copied onto the line, so a later change to the
  /// product — or its deletion — cannot rewrite an issued invoice.
  productId        Int?    @map("product_id")
  /// Set when the line was picked from a specific variant of the product.
  productVariantId Int?    @map("product_variant_id")
  description      String
  /// HSN (goods) or SAC (services) code. Mandatory above the turnover threshold.
  hsnCode      String? @map("hsn_code") @db.VarChar(8)
  unit         String?
  quantity     Decimal @db.Decimal(10, 3)
  /// GST-exclusive unit price.
  rate         Decimal @db.Decimal(12, 2)
  /// quantity x rate, before any discount.
  amount       Decimal @db.Decimal(12, 2)
  /// This line's share of the invoice-level discount, apportioned pro rata.
  discount     Decimal @default(0) @db.Decimal(12, 2)
  /// amount − discount: what GST is charged on for this line.
  taxableValue Decimal @default(0) @map("taxable_value") @db.Decimal(12, 2)
  /// GST percentage for this line (0, 5, 12, 18, 28...).
  gstRate      Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(12, 2)
  sgst         Decimal @default(0) @db.Decimal(12, 2)
  igst         Decimal @default(0) @db.Decimal(12, 2)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@index([productVariantId])
  @@map("invoice_items")
}

model StockMovement {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @map("organization_id")
  productId        Int      @map("product_id")
  productVariantId Int?     @map("product_variant_id")
  /// Movement type: sale, purchase, adjustment, return, opening.
  type             String   @db.VarChar(20)
  /// Positive = stock in, negative = stock out.
  quantity         Decimal  @db.Decimal(10, 3)
  /// What triggered this movement: "invoice", "purchase_order", or null for manual.
  referenceType    String?  @map("reference_type") @db.VarChar(30)
  referenceId      Int?     @map("reference_id")
  notes            String?  @db.Text
  createdBy        Int      @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  user         User            @relation("StockMovementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId, productId])
  @@index([organizationId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}
