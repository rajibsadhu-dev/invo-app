generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  superadmin
  user
}

enum InvoiceStatus {
  draft
  sent
  paid
  cancelled
}

enum PaymentMethod {
  cash
  bank
  upi
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole @default(user)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  organizations Organization[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Organization {
  id                Int      @id @default(autoincrement())
  name              String
  ownerId           Int      @map("owner_id")
  address           String?  @db.Text
  phone             String?
  email             String?
  logo              String?
  registerNumber    String?  @map("register_number")
  gstNumber         String?  @map("gst_number")
  invoicePrefix     String   @default("INV") @map("invoice_prefix")
  nextInvoiceNumber Int      @default(1) @map("next_invoice_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers Customer[]
  invoices  Invoice[]

  @@map("organizations")
}

model Customer {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?  @db.Text
  gstNumber      String?  @map("gst_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@map("customers")
}

model Invoice {
  id                  Int            @id @default(autoincrement())
  organizationId      Int            @map("organization_id")
  customerId          Int            @map("customer_id")
  invoiceNumber       String         @map("invoice_number")
  invoiceDate         DateTime       @default(now()) @map("invoice_date")
  subtotal            Decimal        @db.Decimal(12, 2)
  tax                 Decimal        @default(0) @db.Decimal(12, 2)
  discount            Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal        @map("grand_total") @db.Decimal(12, 2)
  receivedAmount      Decimal        @default(0) @map("received_amount") @db.Decimal(12, 2)
  status              InvoiceStatus  @default(draft)
  amountInWords       String?        @map("amount_in_words") @db.VarChar(500)
  // Optional reference fields
  challanNo           String?        @map("challan_no")
  vehicleNo           String?        @map("vehicle_no")
  siteLocation        String?        @map("site_location")
  billingAddress      String?        @map("billing_address") @db.Text
  referenceNumber     String?        @map("reference_number")
  // Payment info
  paymentMethod       PaymentMethod? @map("payment_method")
  bankName            String?        @map("bank_name")
  bankAccount         String?        @map("bank_account")
  bankIfsc            String?        @map("bank_ifsc")
  transactionNumber   String?        @map("transaction_number")
  // Footer fields
  termsAndConditions  String?        @map("terms_and_conditions") @db.Text
  notes               String?        @db.Text
  authorizedSignatory String?        @map("authorized_signatory")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  description String
  unit        String?
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}
